{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Kelp LRTDepositPool",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x036676389e48133b63a802f8635ad39e752d375d" }] }
  },
  "metadata": {
    "owner": "Kelp DAO",
    "info": { "url": "https://kelpdao.xyz/" },
    "contractName": "Kelp LRT Deposit Pool",
    "constants": { "rsETH": "0xa1290d69c65a6fe4df752f95823fae25cb99e5a7" }
  },
  "display": {
    "formats": {
      "depositETH(uint256 minRSETHAmountExpected, string referralId)": {
        "intent": "Restake ETH",
        "fields": [
          { "path": "@.value", "label": "Amount", "format": "amount", "visible": "always" },
          {
            "path": "#.minRSETHAmountExpected",
            "label": "Minimum rsETH",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.rsETH" },
            "visible": "always"
          },
          { "path": "#.referralId", "label": "Referral id", "visible": "never" }
        ]
      },
      "depositAsset(address asset, uint256 depositAmount, uint256 minRSETHAmountExpected, string referralId)": {
        "intent": "Restake",
        "fields": [
          {
            "path": "#.depositAmount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "tokenPath": "#.asset" },
            "visible": "always"
          },
          {
            "path": "#.minRSETHAmountExpected",
            "label": "Minimum rsETH",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.rsETH" },
            "visible": "always"
          },
          { "path": "#.asset", "label": "Asset", "visible": "never" },
          { "path": "#.referralId", "label": "Referral id", "visible": "never" }
        ]
      }
    }
  }
}
