            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#._amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.RPL" },
            "visible": "always"
          }
        ]
