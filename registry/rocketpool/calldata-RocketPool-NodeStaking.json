          {
            "path": "#._amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.RPL" },
            "visible": "always"
          }
        ]
      },
      "stakeRPLFor(address _nodeAddress, uint256 _amount)": {
