{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Rocket Pool NodeStaking",
    "contract": { "deployments": [{ "chainId": 1, "address": "0xedfc7dcae43ff954577a2875a9d805874490ee3e" }] }
  },
  "metadata": {
