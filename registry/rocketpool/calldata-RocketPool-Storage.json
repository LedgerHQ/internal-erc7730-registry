{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Rocket Pool Storage",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x1d8f8f00cfa6758d7be78336684788fb0ee0fa46" }] }
  },
  "metadata": { "owner": "Rocket Pool", "info": { "url": "https://rocketpool.net/" }, "contractName": "Rocket Pool Storage" },
  "display": {
    "formats": {
      "setWithdrawalAddress(address _nodeAddress, address _newWithdrawalAddress, bool _confirm)": {
        "intent": "Set withdrawal address",
        "fields": [
          {
            "path": "#._nodeAddress",
            "label": "Node",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#._newWithdrawalAddress",
            "label": "New withdrawal addr",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "#._confirm", "label": "Confirm", "format": "raw", "visible": "always" }
        ]
      },
      "confirmWithdrawalAddress(address _nodeAddress)": {
        "intent": "Confirm withdrawal address",
        "fields": [
          {
            "path": "#._nodeAddress",
            "label": "Node",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      }
    }
  }
}
