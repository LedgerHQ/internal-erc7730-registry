{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Stader ETHx StakePoolsManager",
    "contract": { "deployments": [{ "chainId": 1, "address": "0xcf5ea1b38380f6af39068375516daf40ed70d299" }] }
  },
  "metadata": { "owner": "Stader Labs", "info": { "url": "https://staderlabs.com/" }, "contractName": "Stader ETHx Pool" },
  "display": {
    "formats": {
      "deposit(address _receiver, string _referralId)": {
        "intent": "Stake ETH",
        "fields": [
          { "path": "@.value", "label": "Amount", "format": "amount", "visible": "always" },
          {
            "path": "#._receiver",
            "label": "Receiver",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "#._referralId", "label": "Referral id", "visible": "never" }
        ]
      }
    }
  }
}
