{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Stader MaticX Ethereum",
    "contract": { "deployments": [{ "chainId": 1, "address": "0xf03a7eb46d01d9ecaa104558c732cf82f6b6b645" }] }
  },
  "metadata": {
    "owner": "Stader Labs",
    "info": { "url": "https://staderlabs.com/" },
    "contractName": "Stader MaticX",
    "constants": { "MATIC": "0x7d1afa7b718fb893db30a3abc0cfc608aacfebb0", "POL": "0x455e53cbb86018ac2b8092fdcd39d8444affc3f6" }
  },
  "display": {
    "formats": {
      "submit(uint256 _amount)": {
        "intent": "Stake MATIC",
        "fields": [
          {
            "path": "#._amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.MATIC" },
            "visible": "always"
          }
        ]
      },
      "submitPOL(uint256 _amount)": {
        "intent": "Stake POL",
        "fields": [
          {
            "path": "#._amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.POL" },
            "visible": "always"
          }
        ]
      },
      "requestWithdraw(uint256 _amount)": {
        "intent": "Unstake MaticX",
        "fields": [{ "path": "#._amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "@.to" }, "visible": "always" }]
      },
      "claimWithdrawal(uint256 _idx)": { "intent": "Claim POL", "fields": [{ "path": "#._idx", "label": "Request id", "format": "raw", "visible": "always" }] }
    }
  }
}
