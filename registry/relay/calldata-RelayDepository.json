  "metadata": { "owner": "Relay", "info": { "url": "https://relay.link" }, "contractName": "RelayDepository" },
  "display": {
    "formats": {
      "depositNative(address depositor, bytes32 id)": {
        "$id": "depositNative",
        "intent": "Deposit to Relay order",
        "fields": [
          { "path": "@.value", "label": "Amount", "format": "amount", "visible": "always" },
          {
            "path": "depositor",
            "label": "Depositor",
            "format": "addressName",
            "params": { "types": ["wallet", "eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "id", "label": "Relay order ID", "format": "raw", "visible": "always" }
        ]
      },
      "depositErc20(address depositor, address token, uint256 amount, bytes32 id)": {
        "$id": "depositErc20",
        "intent": "Deposit to Relay order",
        "fields": [
          { "path": "amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "token" }, "visible": "always" },
          {
            "path": "depositor",
            "label": "Depositor",
            "format": "addressName",
            "params": { "types": ["wallet", "eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "id", "label": "Relay order ID", "format": "raw", "visible": "always" }
        ]
      },
      "depositErc20(address depositor, address token, bytes32 id)": {
        "$id": "depositErc20FullAllowance",
        "intent": "Deposit allowance to Relay",
        "fields": [
          { "path": "token", "label": "Token (all allowed)", "format": "tokenTicker", "visible": "always" },
          {
            "path": "depositor",
            "label": "Depositor",
            "format": "addressName",
            "params": { "types": ["wallet", "eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "id", "label": "Relay order ID", "format": "raw", "visible": "always" }
        ]
      }
    }
  }
