{
  "$schema": "../../../specs/erc7730-tests.schema.json",
  "tests": [
    {
      "description": "Synthetic (from V1 tx 0x73252f36): lend USDC with an assets target - chain 1",
      "rawTx": "",
      "expectedTexts": ["Lend or repay", "Loan token", "Maturity", "Amount to pay", "Min units to buy", "Referral fee", "Fee recipient"]
    },
    {
      "description": "Synthetic (from V1 tx 0xc0ee400e): repay all debt and withdraw all collateral - chain 1",
      "rawTx": "",
      "expectedTexts": ["Lend or repay", "Loan token", "Maturity", "Units to buy", "All debt", "Max to pay", "Collateral recipient"]
    },
    {
      "description": "Synthetic (from V1 tx 0x7b6f757b): supply WETH collateral and borrow USDC - chain 1",
      "rawTx": "",
      "expectedTexts": ["Borrow or sell", "Loan token", "Maturity", "Amount to receive", "Max units to sell", "Recipient"]
    },
    {
      "description": "Synthetic (from V1 tx 0x7b6f757b): supply WETH collateral and sell units - chain 1",
      "rawTx": "",
      "expectedTexts": ["Borrow or sell", "Loan token", "Maturity", "Units to sell", "Min to receive", "Recipient"]
    },
    {
      "description": "Synthetic: cancel an offer group, park 1,000 USDC on Blue and post a new offers root - chain 1",
      "rawTx": "",
      "expectedTexts": ["Update offers", "Lending funds", "Blue collateral", "Blue oracle", "Blue LLTV", "Loan token", "Maturity", "Authorize ratifier"]
    },
    {
      "description": "Synthetic (from V1 tx 0x7b6f757b): sell all credit - chain 1",
      "rawTx": "",
      "expectedTexts": ["Borrow or sell", "Loan token", "Maturity", "Units to sell", "All credit", "Min to receive", "Recipient"]
    },
    {
      "description": "Synthetic (from V1 tx 0x7b6f757b): supply native ETH as collateral (wrapped via WETH) and borrow USDC - chain 1",
      "rawTx": "",
      "expectedTexts": ["Borrow or sell", "Loan token", "Maturity", "Amount to receive", "Max units to sell", "Recipient", "Amount"]
    }
  ]
