        "$id": "migrate",
        "intent": "Migrate vault position",
        "fields": [
          { "path": "sourceVault", "$ref": "$.display.definitions.vault", "label": "From vault", "visible": "always" },
          { "path": "destVault", "$ref": "$.display.definitions.vault", "label": "To vault", "visible": "always" },
