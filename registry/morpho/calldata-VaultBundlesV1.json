      "vaultBundlesV1Deposit(address vault,uint256 assets,uint256 maxSharePriceE27,(uint8 kind,bytes data) assetPermit,uint256 referralFeePct,address referralFeeRecipient,uint256 deadline)": {
        "$id": "deposit",
        "intent": "Deposit",
        "fields": [
          { "path": "vault", "$ref": "$.display.definitions.vault", "visible": "always" },
          { "path": "assets", "label": "Deposit amount", "format": "raw", "visible": "always" },
          { "path": "maxSharePriceE27", "label": "Max share price", "format": "raw", "visible": "never" },
          { "path": "assetPermit.kind", "label": "Permit kind", "format": "raw", "visible": "never" },
          { "path": "assetPermit.data", "label": "Permit data", "format": "raw", "visible": "never" },
          { "path": "referralFeePct", "$ref": "$.display.definitions.referralFee", "visible": "always" },
          { "path": "referralFeeRecipient", "$ref": "$.display.definitions.feeRecipient", "visible": "always" },
          { "path": "deadline", "$ref": "$.display.definitions.validUntil", "visible": "optional" }
        ]
      },
      "vaultBundlesV1Withdraw(address vault,uint256 assets,uint256 shares,(uint256 value,uint256 nonce,uint256 deadline,uint8 v,bytes32 r,bytes32 s) sharesPermit,uint256 referralFeePct,address referralFeeRecipient,uint256 deadline)": {
