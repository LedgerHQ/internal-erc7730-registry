          { "path": "sharesPermit.nonce", "label": "Permit nonce", "format": "raw", "visible": "never" },
          { "path": "sharesPermit.deadline", "label": "Permit deadline", "format": "raw", "visible": "never" },
          { "path": "sharesPermit.v", "label": "Sig V", "format": "raw", "visible": "never" },
          { "path": "sharesPermit.r", "label": "Sig R", "format": "raw", "visible": "never" },
          { "path": "sharesPermit.s", "label": "Sig S", "format": "raw", "visible": "never" },
          { "path": "referralFeePct", "$ref": "$.display.definitions.referralFee", "visible": "always" },
