{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "ENS Bulk Renewal",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0xa12159e5131b1eEf6B4857EEE3e1954744b5033A" },
        { "chainId": 1, "address": "0xfF252725f6122A92551A5FA9a6b6bf10eb0Be035" }
      ]
    }
  },
  "metadata": { "owner": "ENS", "info": { "url": "https://ens.domains" }, "contractName": "BulkRenewal" },
  "display": {
    "formats": {
      "renewAll(string[] names,uint256 duration)": {
        "intent": "Renew ENS names",
        "fields": [
          { "path": "#.names.[]", "label": "Name (.eth)", "format": "raw" },
          { "path": "#.duration", "label": "Extend by", "format": "duration" },
          { "path": "@.value", "label": "Maximum payment", "format": "amount" }
        ]
      }
    }
  }
}
