{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "$comment": "Chain IDs shown raw (Wormhole uint16, CCTP uint32): the Ethereum app rejects enums on non-uint8 fields (app-ethereum-dev@2c90ee9). destAddr/tokenOut are bytes32 (possibly non-EVM), so shown raw. Amounts in Mayan 8-decimal units, so shown raw.",
  "metadata": {
    "owner": "Mayan Finance",
    "info": {
      "url": "https://mayan.finance"
    },
    "constants": {
      "addressAsNull": "0x0000000000000000000000000000000000000000"
    }
  },
  "display": {
    "definitions": {
      "wormholeDestChain": {
        "label": "Dest. Wormhole ID",
        "format": "raw"
      },
      "cctpDestDomain": {
        "label": "Dest. CCTP domain",
        "format": "raw"
      },
      "destAddr": {
        "label": "Recipient",
        "format": "raw"
      },
      "tokenOut": {
        "label": "Token out",
        "format": "raw"
      },
      "minAmountOut": {
        "label": "Min received (raw)",
        "format": "raw"
      },
      "deadline": {
        "label": "Deadline",
        "format": "date",
        "params": {
          "encoding": "timestamp"
        }
      },
      "gasDrop": {
        "label": "Gas drop (raw)",
        "format": "raw"
      },
      "referrerBps": {
        "label": "Referrer fee",
        "format": "unit",
        "params": {
          "base": "bps",
          "decimals": 0
        }
      }
    }
  }
}
