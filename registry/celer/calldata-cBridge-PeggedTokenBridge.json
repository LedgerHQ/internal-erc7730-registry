{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "cBridge PeggedTokenBridge",
    "contract": { "deployments": [{ "chainId": 56, "address": "0xd443fe6bf23a4c9b78312391a30ff881a097580e" }] }
  },
  "metadata": { "owner": "Celer Network", "info": { "url": "https://celer.network/" }, "contractName": "PeggedTokenBridge" },
  "display": {
    "formats": {
      "burn(address _token, uint256 _amount, address _withdrawAccount, uint64 _nonce)": {
        "intent": "Bridge back",
        "fields": [
          { "path": "#._amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "#._token" } },
          {
            "path": "#._withdrawAccount",
            "label": "Recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] }
          },
          { "path": "#._token", "label": "Token", "visible": "never" },
          { "path": "#._nonce", "label": "Nonce", "visible": "never" }
        ]
      }
    }
  }
}
