{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Brick Towers BatchDeposit",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x990e6f7a8863457dc752e12fabfe572d5704279b" }] }
  },
  "metadata": { "owner": "Brick Towers", "info": { "url": "https://bricktowers.io/" }, "contractName": "BatchDeposit" },
  "display": {
