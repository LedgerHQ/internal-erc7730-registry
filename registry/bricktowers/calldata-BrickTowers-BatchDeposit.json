      "batchDeposit(bytes[] pubkeys, bytes[] withdrawal_credentials, bytes[] signatures, bytes32[] deposit_data_roots)": {
        "intent": "Stake ETH",
        "fields": [
          { "path": "@.value", "label": "Amount", "format": "amount", "visible": "always" },
          { "path": "#.pubkeys.[]", "label": "Validator public key", "format": "raw", "visible": "always" },
          { "path": "#.withdrawal_credentials.[]", "label": "Withdraw credentials", "format": "raw", "visible": "always" },
          { "path": "#.signatures.[]", "label": "Signatures", "visible": "never" },
          { "path": "#.deposit_data_roots.[]", "label": "Deposit data roots", "visible": "never" }
        ]
      }
    }
  }
}
