        "$id": "depositForBurnWithHook",
        "intent": "Bridge with CCTP",
        "fields": [
          { "path": "amount", "$ref": "$.display.definitions.amount", "visible": "always" },
          { "path": "destinationDomain", "$ref": "$.display.definitions.destinationDomain", "visible": "always" },
          { "path": "mintRecipient", "$ref": "$.display.definitions.mintRecipient", "visible": "always" },
          { "path": "maxFee", "$ref": "$.display.definitions.maxFee", "visible": "always" },
          {
